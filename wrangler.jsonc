// Cloudflare Workers: npx wrangler deploy. Секреты: npx wrangler secret put OPENROUTER_API_KEY и т. д.
{
  "name": "capsula",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-01",
  // Отмена запроса клиентом доходит до request.signal: не тратим токены на ответ, который никто не прочитает.
  "compatibility_flags": ["enable_request_signal"],
  "assets": { "directory": "public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "observability": { "enabled": true },
}
